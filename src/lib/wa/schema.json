{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:td-ohd:wa-refs-v1",
  "title": "Wa references-only snapshot and unsaved draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema", "organizationId", "title", "revision", "revisionId", "parentRevisionId", "savedAt", "layoutMode", "alphaAssignment", "alphaId", "members", "pentas"],
  "properties": {
    "kind": {"const": "wa"},
    "schema": {"const": "wa-refs-v1"},
    "organizationId": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "maxLength": 300},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "revisionId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "parentRevisionId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "savedAt": {"type": ["string", "null"], "format": "date-time"},
    "layoutMode": {"enum": ["standard", "observation", "custom"]},
    "alphaAssignment": {"const": "manual"},
    "alphaId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
    "pentas": {"type": "array", "items": {"$ref": "#/$defs/penta"}},
    "manualMetadata": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "notes": {"type": "string"},
        "powerBases": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["memberId", "label", "assignment"],
          "properties": {
            "memberId": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/nonempty"},
            "assignment": {"const": "manual"}, "note": {"type": "string"}, "sourceRef": {"type": "string"}
          }
        }}
      }
    },
    "customPolicy": {
      "type": "object", "additionalProperties": false, "required": ["reason"],
      "properties": {"reason": {"$ref": "#/$defs/nonempty"}, "allowAlphaInPenta": {"type": "boolean"}}
    }
  },
  "allOf": [
    {"if": {"properties": {"revision": {"const": 0}}}, "then": {
      "properties": {"revisionId": {"type": "null"}, "parentRevisionId": {"type": "null"}, "savedAt": {"type": "null"}}
    }, "else": {
      "properties": {"revisionId": {"$ref": "#/$defs/id"}, "savedAt": {"type": "string", "format": "date-time"}}
    }}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["memberId", "personId", "labelSnapshot"],
      "properties": {"memberId": {"$ref": "#/$defs/id"}, "personId": {"$ref": "#/$defs/id"}, "labelSnapshot": {"$ref": "#/$defs/nonempty"}}
    },
    "penta": {
      "type": "object", "additionalProperties": false,
      "required": ["pentaId", "role", "title", "memberIds"],
      "properties": {
        "pentaId": {"$ref": "#/$defs/id"}, "role": {"enum": ["foundation", "expansion", "coordinating"]},
        "title": {"type": "string"}, "memberIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
