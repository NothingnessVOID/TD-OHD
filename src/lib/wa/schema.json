{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:td-ohd:wa-refs-compatible-v2",
  "title": "Wa references-only snapshot and unsaved draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema", "organizationId", "title", "revision", "revisionId", "parentRevisionId", "savedAt", "layoutMode", "alphaAssignment", "alphaId", "members", "pentas"],
  "properties": {
    "kind": {"const": "wa"},
    "schema": {"enum": ["wa-refs-v1", "wa-refs-v2"]},
    "organizationId": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "maxLength": 300},
    "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "revisionId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "parentRevisionId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "savedAt": {"type": ["string", "null"], "format": "date-time"},
    "layoutMode": {"enum": ["standard", "observation", "custom"]},
    "alphaAssignment": {"const": "manual"},
    "alphaId": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "members": {"type": "array", "items": {"$ref": "#/$defs/member"}},
    "pentas": {"type": "array", "items": {"$ref": "#/$defs/penta"}},
    "manualMetadata": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "notes": {"type": "string"},
        "powerBases": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["memberId", "label", "assignment"],
          "properties": {
            "memberId": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/nonempty"},
            "assignment": {"const": "manual"}, "note": {"type": "string"}, "sourceRef": {"type": "string"}
          }
        }}
      }
    },
    "consultation": {
      "type": "object", "additionalProperties": false, "required": ["assignment", "origin"],
      "properties": {
        "assignment": {"const": "manual"}, "origin": {"const": "manual"},
        "specificProblem": {"type": "string"}, "personalManagementNotes": {"type": "string"}, "communicationPlan": {"type": "string"},
        "keyAllyIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "businessAreas": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["pentaId", "workScope", "demand", "requiredSkills"],
          "properties": {"pentaId": {"$ref": "#/$defs/id"}, "workScope": {"type": "string"}, "demand": {"type": "string"}, "requiredSkills": {"type": "array", "items": {"type": "string"}}}
        }},
        "gapIntents": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "pentaId", "theme", "stage", "note"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "pentaId": {"$ref": "#/$defs/id"}, "theme": {"type": "string"}, "stage": {"enum": ["wish_list", "configured", "observed"]}, "note": {"type": "string"}, "sourceRef": {"type": "string"}}
        }}
      }
    },
    "manualCommunicationEdges": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["edgeId", "fromMemberId", "toMemberId", "assignment"],
        "properties": {"edgeId": {"$ref": "#/$defs/id"}, "fromMemberId": {"$ref": "#/$defs/id"}, "toMemberId": {"$ref": "#/$defs/id"}, "assignment": {"const": "manual"}, "label": {"type": "string"}, "note": {"type": "string"}, "sourceRef": {"type": "string"}}
      }
    },
    "customPolicy": {
      "type": "object", "additionalProperties": false, "required": ["reason"],
      "properties": {"reason": {"$ref": "#/$defs/nonempty"}, "allowAlphaInPenta": {"type": "boolean"}}
    }
  },
  "allOf": [
    {"if": {"properties": {"schema": {"const": "wa-refs-v1"}}}, "then": {
      "not": {"anyOf": [{"properties": {"consultation": {}}, "required": ["consultation"]}, {"properties": {"manualCommunicationEdges": {}}, "required": ["manualCommunicationEdges"]}]}
    }},
    {"if": {"properties": {"schema": {"const": "wa-refs-v2"}}}, "then": {
      "anyOf": [{"properties": {"consultation": {}}, "required": ["consultation"]}, {"properties": {"manualCommunicationEdges": {}}, "required": ["manualCommunicationEdges"]}]
    }},
    {"if": {"properties": {"revision": {"const": 0}}}, "then": {
      "properties": {"revisionId": {"type": "null"}, "parentRevisionId": {"type": "null"}, "savedAt": {"type": "null"}}
    }, "else": {
      "properties": {"revisionId": {"$ref": "#/$defs/id"}, "savedAt": {"type": "string", "format": "date-time"}}
    }}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["memberId", "personId", "labelSnapshot"],
      "properties": {"memberId": {"$ref": "#/$defs/id"}, "personId": {"$ref": "#/$defs/id"}, "labelSnapshot": {"$ref": "#/$defs/nonempty"}}
    },
    "penta": {
      "type": "object", "additionalProperties": false,
      "required": ["pentaId", "role", "title", "memberIds"],
      "properties": {
        "pentaId": {"$ref": "#/$defs/id"}, "role": {"enum": ["foundation", "expansion", "coordinating"]},
        "title": {"type": "string"}, "memberIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
