From: Swiss parity contributors <contributor@example.invalid>
Date: Sun, 4 Oct 2026 02:13:57 +0800
Subject: [PATCH] fix: convert UTC DateTime through UT1 time-scale pair
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit


---
 Application/Calendar/CalendarService.cs | 18 ++++++++++--
 validation/Harness.cs.txt               | 19 ++++++++++++
 validation/cases-a.json                 | 21 +++++++++++++
 validation/compare.py                   | 39 +++++++++++++++++++++++++
 4 files changed, 95 insertions(+), 2 deletions(-)
 create mode 100644 validation/Harness.cs.txt
 create mode 100644 validation/cases-a.json
 create mode 100644 validation/compare.py

diff --git a/Application/Calendar/CalendarService.cs b/Application/Calendar/CalendarService.cs
index faeb03b..b8da05f 100755
--- a/Application/Calendar/CalendarService.cs
+++ b/Application/Calendar/CalendarService.cs
@@ -67,14 +67,28 @@ public sealed class CalendarService
     /// <param name="calendar">Calendar to interpret the date in.</param>
     /// <returns>UT1 Julian Day.</returns>
     public JulianDay UtcToJulianDay(DateTime utc, CalendarSystem calendar = CalendarSystem.Gregorian)
-        => JulianDay.FromUtc(utc, calendar);
+    {
+        if (utc.Kind != DateTimeKind.Utc)
+            throw new ArgumentException("DateTime.Kind must be Utc.", nameof(utc));
+        // swe_utc_to_jd semantics, retaining every fractional DateTime tick.
+        var seconds = utc.Second + (utc.Ticks % TimeSpan.TicksPerSecond) / (double)TimeSpan.TicksPerSecond;
+        return UtcToJulianDayPair(utc.Year, utc.Month, utc.Day, utc.Hour, utc.Minute, seconds, calendar).Ut1;
+    }
 
     /// <summary>
     /// Inverse of <see cref="UtcToJulianDay"/>: a Julian Day back to a
     /// UTC <see cref="DateTime"/>.
     /// </summary>
     public DateTime JulianDayToUtc(JulianDay jd, CalendarSystem calendar = CalendarSystem.Gregorian)
-        => jd.ToUtc(calendar);
+    {
+        var utc = JdUt1ToUtc(jd, calendar);
+        // DateTime cannot represent 23:59:60. Keep that limitation explicit;
+        // callers needing leap-second labels can use JdUt1ToUtc directly.
+        if (utc.Second >= 60)
+            throw new NotSupportedException("Leap-second UTC labels cannot be represented by DateTime; use JdUt1ToUtc.");
+        return new DateTime(utc.Year, utc.Month, utc.Day, utc.Hour, utc.Minute, 0, DateTimeKind.Utc)
+            .AddTicks((long)Math.Round(utc.Second * TimeSpan.TicksPerSecond));
+    }
 
     /// <summary>
     /// Builds a Julian Day from a calendar date plus decimal hour.
diff --git a/validation/Harness.cs.txt b/validation/Harness.cs.txt
new file mode 100644
index 0000000..468c806
--- /dev/null
+++ b/validation/Harness.cs.txt
@@ -0,0 +1,19 @@
+using System.Text.Json;
+using SharpAstrology.SwissEphemerides;
+using SharpAstrology.SwissEphemerides.Application.Calendar;
+using SharpAstrology.SwissEphemerides.Application.Bodies;
+using SharpAstrology.SwissEphemerides.Domain.Time;
+using var context=new EphemerisContextBuilder().UseSwissEphFiles(args[0]).DisableMoshier().Build();
+var calendar=new CalendarService();
+while(Console.ReadLine() is {} line){
+ using var doc=JsonDocument.Parse(line);var r=doc.RootElement;
+ if(r.TryGetProperty("utc",out var text)){
+  var date=DateTime.Parse(text.GetString()!,null,System.Globalization.DateTimeStyles.AdjustToUniversal|System.Globalization.DateTimeStyles.AssumeUniversal);
+  var jd=calendar.UtcToJulianDay(date);var back=calendar.JulianDayToUtc(jd);
+  Console.WriteLine(JsonSerializer.Serialize(new{ut1=jd.Value,roundtripSeconds=(back-date).TotalSeconds,utcKind=back.Kind.ToString()}));
+ }else{
+  var s=context.Bodies.Compute((CelestialBody)r.GetProperty("body").GetInt32(),new JulianDay(r.GetProperty("tt").GetDouble()),(EphemerisFlags)r.GetProperty("flags").GetInt32());
+  var x=s.Position;var v=s.Velocity;var lon=Math.Atan2(x.Y,x.X)*180/Math.PI;if(lon<0)lon+=360;
+  Console.WriteLine(JsonSerializer.Serialize(new{longitude=lon,speed=(x.X*v.Y-x.Y*v.X)/(x.X*x.X+x.Y*x.Y)*180/Math.PI,vector=new[]{x.X,x.Y,x.Z,v.X,v.Y,v.Z},source=s.Source.ToString()}));
+ }
+}
